# Server
PORT=5001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/badminton_booking

# JWT
JWT_SECRET=ganti_dengan_secret_key_yang_sangat_rahasia
JWT_EXPIRES_IN=7d

# Session (dibutuhkan oleh passport untuk flow OAuth)
SESSION_SECRET=ganti_dengan_session_secret

# Google OAuth
# Buat kredensial di https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5001/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# Midtrans Payment Gateway (Sandbox)
# Daftar & ambil key di https://dashboard.sandbox.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Batas waktu pembayaran (menit) sebelum booking otomatis dibatalkan
PAYMENT_EXPIRY_MINUTES=15
